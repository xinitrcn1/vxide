@@ -3139,6 +3139,32 @@ self_exec(void)
 
 static int chained;
 
+/*
+ * SIGUSR1 cancels the request running under timeout_s: the server kills
+ * the child that runs it and answers "cancelled", with the state as it
+ * was.  A client signals the whole process group (it cannot tell which
+ * process serves now); the waiter and the running child ignore it.
+ */
+static volatile sig_atomic_t cancel_req;
+
+static void
+on_cancel(int sig)
+{
+	(void)sig;
+	cancel_req = 1;
+}
+
+static void
+cancel_handler(void)
+{
+	struct sigaction sa;
+
+	memset(&sa, 0, sizeof sa);
+	sa.sa_handler = on_cancel;
+	sigemptyset(&sa.sa_mask);
+	sigaction(SIGUSR1, &sa, NULL);	/* no SA_RESTART: poll returns */
+}
+
