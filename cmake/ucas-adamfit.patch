re", "jacobi", "sqrtmod", "qr", "primroot", "dlog", "crt", "congruence", "magic", "ring_factor", "irreducible", "primitive", "ring_roots", "ring_poly", "ring_gcd", "ring_norm", "matrix", "gf2matrix"], "description": "the operation"}, "args": {"type": "object", "description": "the op's named arguments (see the description; the exact schema of each op is in the session tool's schema op)"}}, "required": ["op"], "additionalProperties": false}, "outputSchema": {"type": "object", "required": ["id", "ok", "cmd"], "properties": {"id": {"description": "the request's id, as given (null if none)"}, "ok": {"type": "boolean"}, "cmd": {"type": ["string", "null"]}, "ucas": {"description": "the ucas statements that ran (error positions refer to them)", "type": "string"}, "structured": {"description": "result has fields beyond text", "type": "boolean"}, "result": {"description": "the command's fields (kind, ...); exact values as {value, exact}; expressions as ucas strings that parse back; unstructured commands give {text}", "type": "object"}, "results": {"description": "every result, when the request ran several commands", "type": "array"}, "notes": {"type": "array", "items": {"type": "object", "properties": {"kind": {"enum": ["rule", "info", "assumed", "default"]}, "text": {"type": "string"}}}}, "conditions": {"description": "where the answer holds", "type": "array", "items": {"type": "string"}}, "checks": {"type": "array", "items": {"type": "object", "properties": {"kind": {"type": "string"}, "points": {"type": "integer"}, "max_diff": {"type": "number"}, "passed": {"type": "boolean"}, "text": {"type": "string"}}}}, "proof": {"type": "object", "properties": {"kind": {"enum": ["symbolic", "exhaustive", "sat", "numeric", "search"]}, "text": {"type": "string"}}}, "files": {"type": "array", "items": {"type": "object", "properties": {"name": {"type": "string"}, "mime": {"type": "string"}, "bytes": {"type": "integer"}, "path": {"type": "string"}, "base64": {"type": "string"}}}}, "text": 